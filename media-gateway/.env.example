PORT=8080

# Google provider configuration. Credentials use Application Default Credentials.
GEMINI_API_KEY=replace-with-server-only-key
OPENAI_API_KEY=replace-with-server-only-key
GEMINI_LIVE_MODEL=replace-with-approved-live-translation-model
# Meeting translation uses Cloud Translation Advanced v3 through project ADC.
GOOGLE_CLOUD_PROJECT=replace-with-development-project-id
LIVE_EXTERNAL_ENV=development
LIVE_ALLOWED_GCP_PROJECT=replace-with-the-same-development-project-id
STT_LANGUAGE_CODES=ko-KR,en-US,ja-JP

# Optional provider-only quality probe. Never enable outside the approved dev project.
RUN_LIVE_QUALITY_PROBE=
QUALITY_PCM16_PATH=
QUALITY_SOURCE_LANGUAGE=ko-KR
QUALITY_TARGET_LANGUAGE=en
QUALITY_DIARIZATION=true

# Supabase server access
SUPABASE_URL=https://project-ref.supabase.co
LIVE_ALLOWED_SUPABASE_REF=project-ref
SUPABASE_SECRET_KEY=replace-with-component-specific-sb-secret-key
# Temporary legacy fallback only. Leave empty when SUPABASE_SECRET_KEY is set.
SUPABASE_SERVICE_ROLE_KEY=

# Must exactly match the web server values and be at least 32 characters.
LIVE_GATEWAY_TOKEN_SECRET=replace-with-32-or-more-random-characters
LIVE_VIEWER_TOKEN_SECRET=replace-with-32-or-more-random-characters

# Exact comma-separated browser origins allowed to open /live WebSockets.
# Production fails closed when this list is empty; paths, query strings, and prefix matches are rejected.
LIVE_GATEWAY_ALLOWED_ORIGINS=https://realtime-noel.example.com

# Protects /metrics through an exact Authorization: Bearer value. Use at least 32 random characters.
LIVE_GATEWAY_METRICS_TOKEN=replace-with-32-or-more-random-characters

# Keep false for browser-only Cloud Run access. Enabling this additionally requires the trusted desktop marker and a valid short-lived HOST token.
LIVE_GATEWAY_ALLOW_TRUSTED_NON_BROWSER=false
