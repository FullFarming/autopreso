# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
# The existing client name accepts the current sb_publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-publishable-key
NEXT_PUBLIC_LIVE_GATEWAY_URL=wss://media-gateway.example.run.app/live

# Server-only Supabase access
SUPABASE_SECRET_KEY=replace-with-component-specific-sb-secret-key
# Temporary legacy fallback only. Leave empty when SUPABASE_SECRET_KEY is set.
SUPABASE_SERVICE_ROLE_KEY=
LIVE_EXTERNAL_ENV=development
LIVE_ALLOWED_SUPABASE_REF=project-ref

# Exact origins; comma-separated web origins are allowed.
ALLOWED_ORIGINS=http://localhost:3000
CHROME_EXTENSION_ORIGIN=chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Host login. Password must be 5+ characters and not a known placeholder; the
# replace-with-* value is intentionally invalid and production rejects it.
ADMIN_USER_IDS=admin
ADMIN_PASSWORD=replace-with-32-or-more-random-characters
# Development/test only; leave false in production.
LIVE_ALLOW_WEAK_TEST_LOGIN=false
LIVE_TEST_LOGIN_ID=
LIVE_TEST_LOGIN_PASSWORD=

# These replace-with-* examples are intentionally invalid. Production rejects
# known placeholders regardless of length; replace every value with a unique,
# randomly generated secret before deployment.
SESSION_SECRET=replace-with-32-or-more-random-characters
PAIR_SECRET=replace-with-32-or-more-random-characters
LIVE_ADMISSION_PEPPER=replace-with-32-or-more-random-characters
LIVE_VIEWER_TOKEN_SECRET=replace-with-32-or-more-random-characters
LIVE_GATEWAY_TOKEN_SECRET=replace-with-32-or-more-random-characters
