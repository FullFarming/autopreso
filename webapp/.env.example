# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
# The existing client name accepts the current sb_publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-publishable-key
NEXT_PUBLIC_LIVE_GATEWAY_URL=wss://media-gateway.example.run.app/live
# Registered calls warm one hour before start by default. Set false only for a
# development deployment that intentionally disables the browser backup warmup.
NEXT_PUBLIC_LIVE_GATEWAY_PREWARM_ENABLED=false
# Server-only copy used by the five-minute scheduled readiness job.
LIVE_GATEWAY_URL=wss://media-gateway.example.run.app/live
# Vercel Cron bearer secret. Use a unique random value of at least 32 characters.
CRON_SECRET=replace-with-32-or-more-random-characters

# Server-only Supabase access
SUPABASE_SECRET_KEY=replace-with-component-specific-sb-secret-key
# Temporary legacy fallback only. Leave empty when SUPABASE_SECRET_KEY is set.
SUPABASE_SERVICE_ROLE_KEY=
LIVE_EXTERNAL_ENV=development
LIVE_ALLOWED_SUPABASE_REF=project-ref
# Local E2E only. In non-production, true permits exactly http://127.0.0.1:54321
# or http://localhost:54321 at the root path; production always rejects it.
LIVE_ALLOW_LOCAL_SUPABASE=false

# Exact origins; comma-separated web origins are allowed.
ALLOWED_ORIGINS=http://localhost:3000
CHROME_EXTENSION_ORIGIN=chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Host login. Prefer ADMIN_PASSWORD_HASH generated by createHostPasswordHash.
# scrypt-v1 uses N=131072, r=8, p=1, a 16-byte salt and a 64-byte key.
# Escape each $ as \$ in .env files because Next.js expands $variable values.
# Set only in server configuration; never use a NEXT_PUBLIC_ variable.
# ADMIN_PASSWORD_HASH=scrypt-v1\$<32-hex-salt>\$<128-hex-key>
# An explicitly configured hash takes precedence; malformed hashes fail closed.
# Legacy plaintext configuration remains supported (10+ characters, no placeholders).
ADMIN_USER_IDS=noel
# ADMIN_PASSWORD= (legacy only; prefer configure-admin-login.mjs)
# Development/test only; leave false in production.
LIVE_ALLOW_WEAK_TEST_LOGIN=false
LIVE_TEST_LOGIN_ID=
LIVE_TEST_LOGIN_PASSWORD=

# Required: real owner email for noel password login to establish an admin profile.
# Supabase Auth bootstrap: these emails become approved admins on first login and
# inherit the first ADMIN_USER_IDS entry as their host_id so existing sessions stay owned.
ADMIN_BOOTSTRAP_EMAILS=

# These replace-with-* examples are intentionally invalid. Production rejects
# known placeholders regardless of length; replace every value with a unique,
# randomly generated secret before deployment.
SESSION_SECRET=replace-with-32-or-more-random-characters
PAIR_SECRET=replace-with-32-or-more-random-characters
LIVE_ADMISSION_PEPPER=replace-with-32-or-more-random-characters
LIVE_VIEWER_TOKEN_SECRET=replace-with-32-or-more-random-characters
LIVE_GATEWAY_TOKEN_SECRET=replace-with-32-or-more-random-characters

# Enable only after migrations 202608310002-004 and matching web/gateway rollout.
# False preserves legacy sessions; active demand sessions reject a silent downgrade.
LIVE_PARTICIPANT_DEMAND_ENABLED=false

# Managed desktop captions: server-only provider keys. Never prefix with NEXT_PUBLIC_.
# Soniox captions need only SONIOX_API_KEY; Gemini assignment and recap need GEMINI_API_KEY.
SONIOX_API_KEY=
GEMINI_API_KEY=
