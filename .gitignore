# Dependencies
node_modules/
.claude/scheduled_tasks.lock

# Local Moonshine development environment
.autopreso-dev/

# Generated release sidecar binaries
packages/*/bin/

# Environment and secrets
.env
.env.*
!.env.example

# Supabase CLI local project link state
supabase/.temp/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and build output
coverage/
dist/
.nyc_output/
# build/ holds electron-builder signing config, not build output. Exclude its
# contents rather than the directory itself -- git cannot re-include a file
# whose parent directory is excluded, so `build/` + `!build/...` would not work.
build/*
!build/entitlements.mac.plist

# Python cache and virtual environments
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Agent/tool scratch state. These held ~183 files and made `git status`
# unreadable, which is how 161 real source files went uncommitted for weeks.
# Ignoring them does not delete them.
.bkit/
.lazyweb/
.playwright-cli/
.claude/agent-memory/
.claude/worktrees/

# Design-QA and audit screenshots: regenerable artifacts, not sources.
output/

# Editor and OS files
.DS_Store
.idea/
.vscode/
*.swp
